{
  "Description": "S3 Vectors Enhanced index parameters. SAM builds the custom-resource Lambda from the repository source.",
  "Configuration": [
    {"Key": "EnvironmentName", "Value": "${EnvironmentName}", "Default": "dev"},
    {"Key": "KmsKeyArn", "Value": "${CF_OUT_KmsKeyArn}"},
    {"Key": "RuntimeExecutionRoleArn", "Value": "${CF_OUT_RuntimeExecutionRoleArn}"},
    {"Key": "ToolsExecutionRoleArn", "Value": "${CF_OUT_ToolsExecutionRoleArn}"},
    {"Key": "VectorIndexName", "Value": "${VECTOR_INDEX_NAME}", "Default": "evidence"},
    {"Key": "VectorDimension", "Value": "${VECTOR_DIMENSION}", "Default": "1024"},
    {"Key": "TextSearchFields", "Value": "${VECTOR_TEXT_SEARCH_FIELDS}", "Default": "text,title"}
  ]
}
